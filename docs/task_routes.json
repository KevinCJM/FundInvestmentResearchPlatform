{
  "schema_version": "1.2",
  "scope_mode": "subtree_only",
  "routing_policy": {
    "operational_list_owner": "docs/repo_map.json",
    "route_to_module_field": "first_read_modules",
    "expand_module_field": "expand_to_modules",
    "operational_list_resolution": {
      "apply_to_fields": [
        "first_read_files",
        "then_check_files",
        "related_tests",
        "related_configs",
        "minimum_regression"
      ],
      "selected_modules_order": "first_read_modules_then_expand_to_modules_when_triggered",
      "merge_strategy": "stable_order_union",
      "dedupe": "exact_string",
      "route_level_override": "forbidden"
    },
    "grounding_gate": {
      "blocking_fact_status": [
        "mixed",
        "needs_code_confirmation"
      ],
      "required_action": "read_grounding_unsampled_paths_before_claim"
    }
  },
  "rule_catalog": {
    "expand_search": {
      "read_reference_map_first": {
        "action": "read_reference_map"
      },
      "read_frontend_backend_pair": {
        "action": "expand_to_coupled_frontend_or_backend_modules_before_api_shape_changes"
      },
      "inspect_window_and_cache_contract": {
        "action": "expand_to_strategy_backtest_and_allocation_ui_when_rebalance_or_cache_fields_change"
      },
      "inspect_data_schema_contract": {
        "action": "expand_to_data_ingestion_config_when parquet columns or DATA_DIR behavior are relevant"
      },
      "inspect_dual_route_definitions": {
        "action": "check backend/app.py inline endpoints and services routers before changing shared API paths"
      },
      "inspect_security_surface": {
        "action": "check config and ingestion scripts before token, CORS, or external API changes"
      }
    },
    "stop_and_verify": {
      "run_minimum_regression": {
        "action": "run_minimum_regression"
      },
      "run_backend_strategy_regression": {
        "action": "run_strategy_backtest_window_pytest_subset"
      },
      "run_backend_analytics_regression": {
        "action": "run_analytics_pytest_subset"
      },
      "run_frontend_build_when_deps_available": {
        "action": "run_vitest_and_vite_build_after_node_dependencies_are_installed"
      },
      "validate_ai_routing": {
        "action": "run_ai_routing_validate_and_route_task_smoke"
      }
    },
    "fact_check": {
      "verify_operator_causality_baseline": {
        "action": "verify current operator causality metadata and future-perturbation probes against the registry and causality baseline"
      },
      "verify_factor_research_temporal_and_release_contracts": {
        "action": "verify distinct characteristic versus return-series outputs, purged labels and maturity-dated rolling IC, frozen-input delayed-entry spreads, uploaded FF3 reference breakpoints and lagged weights, no missing-held-asset renormalization, explicit RF/total-return basis, checked downloads, actual fixed-signature NJIT readiness, immutable research-only releases and pending product-pool admission"
      },
      "read_reference_map_first": {
        "action": "read_reference_map"
      },
      "read_unsampled_module_paths": {
        "action": "read_grounding_unsampled_paths"
      },
      "verify_parquet_schema_or_tmp_fixture": {
        "action": "verify data schema through docs, tests, or temporary parquet fixtures before runtime claims"
      },
      "verify_no_secret_values": {
        "action": "do not reproduce token values; verify frontend-managed credentials stay in an ignored private local file and are never returned or logged"
      },
      "verify_api_payload_shape": {
        "action": "compare frontend fetch payloads with backend Pydantic/request handling before editing"
      },
      "verify_restricted_formula_contract": {
        "action": "verify AST whitelist, operator signatures and DAG budgets; preserve legacy single-scalar contracts while validating every named scalar-bundle root separately, with explicit output references and no mixed-shape public bundle"
      },
      "verify_real_series_window_and_revision_lock": {
        "action": "verify real parquet-only windows, null plus warning semantics, optimistic revisions, and plan-locked indicator history"
      },
      "verify_typed_context_and_portfolio_snapshot": {
        "action": "verify nominal typed-v2 axes/context separation, strict common-date alignment, next-common-day weight effectiveness, and immutable snapshot fields"
      },
      "verify_typed_21_registry_and_availability": {
        "action": "verify DSL/operator/variable/data/context version locks, nominal axes, semantic dimensions, price bases, bool-mask signatures, pure-mathematics public operators, typed 2.0 compatibility, dependency-driven multi-target field availability, and fail-closed target/period/as-of checks"
      },
      "verify_locked_metric_presentation_and_unavailable_states": {
        "action": "verify locked MetricPresentation metadata drives scale, precision, unit, direction, null status, ranking contribution, and browser preference behavior, while structured input requirements explain runtime field availability across modules"
      },
      "verify_generation_bound_batch_arrays_and_worker_cleanup": {
        "action": "verify dependency-grouped scans, generation-bound data and window caches, shared descriptor transport, single-owner cleanup, worker retry, timeout, and CPU admission behavior"
      },
      "verify_fused_kernel_parity_and_paged_result_contract": {
        "action": "verify all fused built-in values and statuses against typed runtime, strict ranking parity, execution metadata, paged result retention, 410 expiration, and busy Retry-After contracts"
      },
      "verify_market_snapshot_and_dashboard_boundaries": {
        "action": "verify active-manifest resolution, full-snapshot validation before activation, request-path small-table reads, distinct ETF/fund date semantics, and null-not-zero metric handling"
      }
    }
  },
