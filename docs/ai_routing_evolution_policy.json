        "frontend/src/pages/PortfolioConstruction.tsx",
        "frontend/src/pages/PortfolioConstruction.test.tsx",
        "frontend/src/pages/HoldingDiagnosis.tsx",
        "frontend/src/pages/HoldingDiagnosis.test.tsx",
        "frontend/src/pages/HistoricalRegime*.tsx",
        "frontend/src/pages/ResearchDataLab*.tsx",
        "frontend/src/pages/ScenarioAlgorithmCenter*.tsx",
        "frontend/src/pages/regime-workbench/**",
        "frontend/src/components/HistoricalRegimeBacktest*.tsx",
        "frontend/src/services/historicalRegimes.ts",
        "frontend/src/services/regimeGraph.ts",
        "frontend/src/services/researchSeries.ts",
        "frontend/src/services/scenarioStress.ts",
        "frontend/src/services/portfolioRegime.ts",
        "frontend/src/pages/ProductResearch.test.tsx",
        "frontend/src/pages/EvaluationPlan.test.tsx",
        "frontend/src/pages/ProductDetail.test.tsx",
        "frontend/src/pages/ProductCompare.test.tsx",
        "frontend/src/utils/statisticalAnalysis.ts",
        "frontend/src/utils/statisticalAnalysis.test.ts",
        "frontend/src/services/customIndicators.ts",
        "frontend/e2e/metric-display.spec.ts",
        "frontend/src/services/portfolioResearch.ts",
        "frontend/src/services/portfolioResearch.test.ts"
      ]
    }
  }
}
