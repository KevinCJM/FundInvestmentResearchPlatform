# Public deployment settings
APP_PORT=8000

# Keep empty when the browser and API share one public domain. For a separately
# hosted frontend, provide one or more comma-separated HTTPS origins.
CORS_ALLOW_ORIGINS=

# Browser-triggered writes are enabled by default only in development. Keep the
# production default off unless this endpoint is protected by your deployment.
DATA_REFRESH_ENABLED=false
# Token is entered from the Dashboard data-management drawer and stored only in
# the local data/.tushare_token credential file. Set false to disable editing it.
TUSHARE_TOKEN_CONFIG_ENABLED=true
# Activity timeout: reset whenever the downloader emits progress. Set 0 to disable.
DATA_REFRESH_IDLE_TIMEOUT_SECONDS=1800
# Optional absolute cap for the whole background task. 0 means no hard cap.
DATA_REFRESH_MAX_RUNTIME_SECONDS=0
DATA_FULL_REFRESH_ENABLED=false
DATA_FULL_REFRESH_IDLE_TIMEOUT_SECONDS=7200
DATA_FULL_REFRESH_MAX_RUNTIME_SECONDS=0
TUSHARE_MAX_CALLS_PER_MINUTE=180
TUSHARE_MIN_CALL_INTERVAL_SECONDS=0.34
TUSHARE_MAX_LATEST_DAYS=120
TUSHARE_MAX_WORKERS=8
TUSHARE_MAX_FUND_BASIC_PAGES=20
TUSHARE_MAX_FUND_NAV_PAGES=20
TUSHARE_FUND_NAV_PAGE_SIZE=10000
TUSHARE_MAX_RETRIES=5
TUSHARE_RETRY_BACKOFF_SECONDS=2.0
TUSHARE_RATE_LIMIT_WAIT_SECONDS=15.0
TUSHARE_RETRY_JITTER_SECONDS=0.5
TUSHARE_FULL_START_DATE=20100101
TUSHARE_HISTORY_CHUNK_DAYS=3650

# Indicator batch engine (8-core / 16GB reference defaults)
INDICATOR_BATCH_ENGINE_V2=on
INDICATOR_PROCESS_WORKERS=7
INDICATOR_STARTUP_WARMUP_TIMEOUT_SECONDS=120
INDICATOR_QUEUE_WAIT_SECONDS=1
INDICATOR_RUN_HARD_TIMEOUT_SECONDS=600
INDICATOR_PRANGE_MIN_ELEMENTS=300000
INDICATOR_SHM_THRESHOLD_BYTES=536870912
INDICATOR_CACHE_TTL_SECONDS=300
INDICATOR_PLAN_CACHE_ENTRIES=32
INDICATOR_DATA_CACHE_BYTES=536870912
INDICATOR_WINDOW_CACHE_BYTES=268435456
INDICATOR_INLINE_RESULT_LIMIT=2000
INDICATOR_RESULT_TTL_SECONDS=1800
INDICATOR_RESULT_MAX_RUNS=20
INDICATOR_RESULT_MAX_BYTES=2147483648
INDICATOR_ORPHAN_PROTECTION_SECONDS=60
