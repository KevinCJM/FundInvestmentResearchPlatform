        "frontend/src/pages/TradeAllocationWorkspace.tsx",
        "frontend/src/pages/TradeAllocationWorkspace.test.tsx",
        "frontend/src/pages/AccountStatementAllocationWorkspace.tsx",
        "frontend/src/pages/AccountStatementAllocationWorkspace.test.tsx",
        "frontend/src/pages/AccountingBookingWorkspace.tsx",
        "frontend/src/pages/AccountingBookingWorkspace.test.tsx",
        "frontend/src/pages/FinancialStatementsWorkspace.tsx",
